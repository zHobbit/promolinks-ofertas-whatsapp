# ==========================================================
#  Modelo de variáveis de ambiente — copie para .env e preencha
#  (o .env real NUNCA deve ir pro Git)
# ==========================================================

# --- Postgres ---
POSTGRES_USER=ofertas
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_DB=app

# --- n8n (interface http://localhost:5678) ---
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=troque-por-uma-senha-forte
N8N_ENCRYPTION_KEY=gere-uma-chave-de-32-caracteres
GENERIC_TIMEZONE=America/Sao_Paulo
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http

# --- Mercado Livre: aplicação de desenvolvedor (developers.mercadolivre.com.br) ---
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_USER_ID=
ML_ACCESS_TOKEN=
ML_REFRESH_TOKEN=

# --- Mercado Livre: afiliado (link gerado pelo endpoint interno do Linkbuilder) ---
# Capture via DevTools (Copy as cURL) na página /afiliados/linkbuilder.
# O CSRF é renovado automaticamente pelo fluxo; mantenha o COOKIE (ssid) válido.
ML_AFF_TAG=seu_tag_de_afiliado
ML_AFF_CSRF=
ML_AFF_COOKIE=

# --- Evolution API (WhatsApp) ---
EVOLUTION_API_KEY=gere-uma-chave-aleatoria

# --- Shopee Affiliate Open API (quando tiver acesso aprovado) ---
SHOPEE_APP_ID=
SHOPEE_SECRET=
